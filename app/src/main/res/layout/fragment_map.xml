<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/bg_overlay"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/map_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#212121"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/map_show_incidents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/map_incidents"
                android:textColor="#212121"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/map_show_roadworks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/map_roadworks"
                android:textColor="#212121"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/map_show_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map_show_all"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
